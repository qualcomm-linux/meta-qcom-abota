software =
{
    version = "";

    stable:
    {
        hardware-compatibility: [ "@@MACHINE@@" ];

        slot_a:
        {
            hardware-compatibility: [ "@@MACHINE@@" ];

            images: (
                {
                    filename = "@@SWUPDATE_IMAGE_SYSTEM@@";
                    device = "/dev/disk/by-partlabel/system";
                    type = "raw";
                    installed-directly = true;
                    sha256 = "$swupdate_get_sha256(@@SWUPDATE_IMAGE_SYSTEM@@)";
                },
                {
                    filename = "@@SWUPDATE_IMAGE_EFI@@";
                    device = "/dev/disk/by-partlabel/efi";
                    type = "raw";
                    installed-directly = true;
                    sha256 = "$swupdate_get_sha256(@@SWUPDATE_IMAGE_EFI@@)";
                }
            );

            scripts: (
                {
                    filename = "qcom-postinstall-abota.sh";
                    type = "postinstall";
                    sha256 = "$swupdate_get_sha256(qcom-postinstall-abota.sh)";
                }
            );
        };

        slot_b:
        {
            hardware-compatibility: [ "@@MACHINE@@" ];

            images: (
                {
                    filename = "@@SWUPDATE_IMAGE_SYSTEM@@";
                    device = "/dev/disk/by-partlabel/system_b";
                    type = "raw";
                    installed-directly = true;
                    sha256 = "$swupdate_get_sha256(@@SWUPDATE_IMAGE_SYSTEM@@)";
                },
                {
                    filename = "@@SWUPDATE_IMAGE_EFI@@";
                    device = "/dev/disk/by-partlabel/efi_b";
                    type = "raw";
                    installed-directly = true;
                    sha256 = "$swupdate_get_sha256(@@SWUPDATE_IMAGE_EFI@@)";
                }
            );

            scripts: (
                {
                    filename = "qcom-postinstall-abota.sh";
                    type = "postinstall";
                    sha256 = "$swupdate_get_sha256(qcom-postinstall-abota.sh)";
                }
            );
        };
    };
}
