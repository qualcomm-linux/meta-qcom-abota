-uefi_sec_CPPFLAGS = $(AM_CPPFLAGS) $(QCOMTEE_CFLAGS)
+uefi_sec_CPPFLAGS = $(AM_CPPFLAGS) $(MINKADAPTOR_CFLAGS) -I$(builddir)
 uefi_sec_CFLAGS = $(AM_CFLAGS)
-uefi_sec_LDFLAGS = -lpthread
